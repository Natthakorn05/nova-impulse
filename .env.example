# Copy to .env and fill in. NEVER commit .env.
# Art generation is a BUILD-TIME step — the game itself never calls these APIs,
# so none of these keys are required to play.

# --- Cloudflare Workers AI (recommended: free tier, no card, best anime output) ---
# Account ID: dash.cloudflare.com -> Workers & Pages -> Overview -> right sidebar
# API Token:  My Profile -> API Tokens -> Create Token -> "Workers AI" template
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_MODEL=@cf/black-forest-labs/flux-1-schnell

# --- Pollinations (no key needed at all — used automatically as fallback) ---
# nothing to configure

# --- Optional others ---
# HF_TOKEN=                 # Hugging Face (free tier no longer serves image models)
# TOGETHER_API_KEY=         # Together AI, free FLUX.1-schnell endpoint
# GEMINI_API_KEY=           # Google AI Studio — image gen needs BILLING enabled

# Provider order + pacing
# ART_PROVIDER=cloudflare
# ART_DELAY_MS=1200

# --- Text LLM, for netlify/functions/companion.mjs (all free tier) ---
# These power companion chat, the run epilogue, Breach floor names and boss
# lines. All four features fail silently without them, so the game is fully
# playable with none of these set.
#
# In production these belong in Netlify's environment variables, NOT here —
# .env is never uploaded. This file is only for running the function locally.
# Tried in this order; the first one with a key wins.
# GROQ_API_KEY=             # console.groq.com — llama-3.3-70b-versatile
# GEMINI_API_KEY=           # aistudio.google.com — gemini-flash-latest (text is free)
# CEREBRAS_API_KEY=         # cloud.cerebras.ai — gpt-oss-120b
